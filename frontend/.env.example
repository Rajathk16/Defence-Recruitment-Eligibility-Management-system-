NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# BUG-17 FIX: these two variables are REQUIRED for the app to function correctly.
# SESSION_SECRET: a long random string used to sign JWT session cookies.
#   Generate one with: openssl rand -base64 48
#   WARNING: if this is missing, the app will throw an error on startup (see lib/auth.ts).
SESSION_SECRET=your-strong-random-secret-min-32-chars-here

# OFFICER_ACCESS_CODE: 4-digit numeric code for officer login (default was 4827 in dev).
#   Change this before deploying to production.
OFFICER_ACCESS_CODE=your-4-digit-officer-code-here
